# Server-side only. Never use VITE_* for these keys.
OPENAI_API_KEY=
TMAP_APP_KEY=
# TMS 앱이 다르면 별도 키. 비워 두면 TMAP_APP_KEY를 사용한다.
TMS_APP_KEY=
USE_MOCK=1
# offline: 외부 호출 없는 시연. openai: MAIN_MODEL과 OPENAI_API_KEY 필요.
MODEL_MODE=offline
# 계정에서 사용 가능한 모델명을 입력한다.
MAIN_MODEL=
# 본사 센터. 날짜를 비워 두면 사용자에게 확인한다.
DEPOT_ID=CENTER-NR
DEFAULT_DELIVERY_DATE=
# 실제 TMS 마스터 등록값을 확인한 담당자만 1로 설정한다.
TMS_MASTER_VERIFIED=0
# TMS 결과 대기와 모델 호출 한도
TMS_POLL_INTERVAL_SECONDS=1
TMS_POLL_MAX_ATTEMPTS=30
TOOL_MAX_RETRIES=3
MAX_TOOL_ITERATIONS=6
## 로컬 시연용 CSV 디렉터리. 비우면 저장소의 기본 샘플을 사용한다.
BADARO_DATA_DIR=
